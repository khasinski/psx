#!/usr/bin/env ruby
# frozen_string_literal: true

# PlayStation 1 emulator — graphical front-end. Loads a BIOS image and runs
# the emulator with an SDL window for display + keyboard controller input.

RubyVM::YJIT.enable if defined?(RubyVM::YJIT.enable)

require "psx"

def usage
  warn <<~USAGE
    PSX — PlayStation 1 emulator (#{PSX::VERSION})

    Usage: psx [options] <bios.bin> [disc.cue|disc.bin]

    Options:
      -f, --fps N         Target FPS (default: 60)
      -n, --no-frameskip  Disable frame skipping
          --fast-boot     Skip the BIOS shell UI and boot the disc's PS-EXE
                          from SYSTEM.CNF. Retail discs still use the BIOS
                          bootstrap when the license check can complete.
      -v, --version       Print version and exit
      -h, --help          Show this help

    Defaults (FPS, frame skip, paths, key bindings) come from
    ~/.config/psx/config.yml (override with $PSX_CONFIG). Open the
    in-window settings overlay with Tab.

    Default keyboard mapping (slot 1 digital pad):
      Arrow keys    D-pad
      Z / X         Cross / Circle
      A / S         Square / Triangle
      Enter / Space Start / Select
      Q / W         L1 / R1
      E / R         L2 / R2
      Tab           Open settings overlay (rebind keys)
      F5            Quicksave (PSX_QUICKSAVE overrides)
      F6            State+screenshot (PSX_DEBUG_SNAPSHOT overrides)
      F8            Quickload
      Escape        Quit

    A BIOS ROM (e.g. SCPH1001.BIN, 512 KB) is required and must be provided
    by the user; PSX-Ruby does not ship one.
  USAGE
  exit 1
end

config = PSX::Config.load
target_fps = config.target_fps
frameskip = config.frameskip
fast_boot = false
positional = []

args = ARGV.dup
while (arg = args.shift)
  case arg
  when "-f", "--fps"
    target_fps = args.shift&.to_i
    usage if target_fps.nil? || target_fps <= 0
  when "-n", "--no-frameskip"
    frameskip = false
  when "--fast-boot"
    fast_boot = true
  when "-v", "--version"
    puts PSX::VERSION
    exit 0
  when "-h", "--help"
    usage
  else
    positional << arg
  end
end

bios_path, disc_path = positional
usage unless bios_path

unless File.exist?(bios_path)
  warn "Error: BIOS file not found: #{bios_path}"
  exit 1
end

if disc_path && !File.exist?(disc_path)
  warn "Error: disc image not found: #{disc_path}"
  exit 1
end

puts "PSX-Ruby #{PSX::VERSION}"
puts "Loading BIOS: #{bios_path}"
puts "Disc: #{disc_path || '(none — shell only)'}"
puts "Target FPS: #{target_fps}"
puts "Frame skip: #{frameskip ? 'enabled' : 'disabled'}"
puts "Config: #{config.path}"
puts "YJIT: #{defined?(RubyVM::YJIT) && RubyVM::YJIT.enabled? ? 'enabled' : 'disabled'}"
puts ""

begin
  emu = PSX::Emulator.new(bios_path, disc_path: disc_path, fast_boot: fast_boot)
  if fast_boot
    raise "--fast-boot requires a disc image" unless disc_path
    boot = emu.fast_boot_from_disc
    puts "Fast-boot: loaded #{boot} from #{disc_path}"
  end
  emu.run_with_display(target_fps: target_fps, frameskip: frameskip, config: config)
rescue Interrupt
  puts "\nInterrupted by user"
rescue => e
  warn "\nError: #{e.message}"
  warn e.backtrace.first(5).join("\n")
  exit 1
end
